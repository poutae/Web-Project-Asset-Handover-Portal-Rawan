# /etc/portal/portal.env  (mode 0640, owner root:portal). Real values live only on the server.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
ConnectionStrings__Default=Server=localhost;Database=Portal;User Id=portal_app;Password=CHANGE_ME;TrustServerCertificate=true
Database__MigrateOnStartup=false

Frontend__DistPath=/opt/portal/wwwroot
Storage__Root=/var/lib/portal/storage
DataProtection__KeysPath=/var/lib/portal/keys

# Deploy on Our Platform
Deploy__Root=/var/lib/portal/deployments
Deploy__BaseDomain=sites.example.com
Deploy__PublicScheme=https
Deploy__Sandbox=systemd
Deploy__SudoHelperPath=/usr/local/lib/portal/run-build

# Housekeeping (optional; these are the defaults)
# Cleanup__Enabled=true
# Cleanup__Interval=06:00:00
# Cleanup__IdempotencyRetention=30.00:00:00
# Cleanup__OrphanGracePeriod=1.00:00:00
# Cleanup__MaxOrphansPerRun=500
