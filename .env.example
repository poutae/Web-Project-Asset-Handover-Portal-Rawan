# Copy to .env for local development. Never commit .env.
# Values below are placeholders / local-only defaults, not real credentials.

# --- Backend ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# SQL Server on localhost using Windows integrated auth (no password needed).
# For SQL authentication use: Server=localhost;Database=PortalDev;User Id=<user>;Password=<password>;TrustServerCertificate=true
ConnectionStrings__Default=Server=localhost;Database=PortalDev;Integrated Security=true;TrustServerCertificate=true

# --- Frontend (Vite dev server) ---
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:5080
